{
  "version": "0.2.0",
  "signatureAlgorithm": "HMAC-SHA256",
  "canonicalPayload": ["channel", "externalConversationId", "timestamp", "content"],
  "platformSignatureProfiles": [
    {
      "id": "wechat-official-callback",
      "channel": "WeChat",
      "adapterEndpoint": "POST /api/channels/wechat/inbound",
      "signatureHeader": "X-WX-Signature",
      "timestampHeader": "X-WX-Timestamp",
      "replayHeader": "X-WX-Msg-ID",
      "canonicalPayload": ["openId", "msgId", "timestamp", "text"],
      "sampleCanonicalPayload": ["wx-open-adapter-example", "wechat-adapter-msg-example-1", "2026-06-14T03:10:00Z", "这个商品能不能开发票？"],
      "demoSecret": "wechat-demo-secret",
      "sampleSignature": "2c7680a911e3f401651628b884eaac6fd28acb5e3cc4265233396df0a2568942",
      "retrySemantics": "WeChat may retry the same msgId; replay protection must prefer msgId over signed payload.",
      "failureCodes": ["invalid_signature", "stale_signature", "duplicate_inbound"]
    },
    {
      "id": "app-mobile-sdk-callback",
      "channel": "App",
      "adapterEndpoint": "POST /api/channels/app/inbound",
      "signatureHeader": "X-App-Signature",
      "timestampHeader": "X-App-Sent-At",
      "replayHeader": "X-App-Message-ID",
      "canonicalPayload": ["deviceId", "messageId", "sentAt", "body"],
      "sampleCanonicalPayload": ["device-example-1", "app-msg-example-1", "2026-06-14T03:10:00Z", "订单状态在哪里看？"],
      "demoSecret": "app-demo-secret",
      "sampleSignature": "f81820e1abe6a2e22217e4e6ac991e6e251e54e08325dd24a1eb71730a1acd05",
      "retrySemantics": "The mobile SDK may resend after network loss; messageId is stable across retries.",
      "failureCodes": ["channel_rate_limited", "stale_signature", "duplicate_inbound"]
    },
    {
      "id": "marketplace-order-message-callback",
      "channel": "Marketplace",
      "adapterEndpoint": "POST /api/channels/marketplace/inbound",
      "signatureHeader": "X-Marketplace-Signature",
      "timestampHeader": "X-Marketplace-Occurred-At",
      "replayHeader": "X-Marketplace-Event-ID",
      "canonicalPayload": ["buyerId", "eventId", "occurredAt", "message"],
      "sampleCanonicalPayload": ["buyer-example-1", "market-event-example-1", "2026-06-14T03:10:00Z", "可以修改收货地址吗？"],
      "demoSecret": "marketplace-demo-secret",
      "sampleSignature": "84f30a369be67f265c4fa242b385c2a845dd5e9c2b160cafaede2fccd7e9f9dd",
      "retrySemantics": "Marketplace retries order events at least once; eventId is the settlement-safe idempotency key.",
      "failureCodes": ["invalid_signature", "invalid_timestamp", "duplicate_inbound"]
    }
  ],
  "examples": [
    {
      "id": "wechat-standard-inbound",
      "channel": "WeChat",
      "endpoint": "POST /api/channels/inbound",
      "headers": {
        "Content-Type": "application/json",
        "X-Channel-Origin": "https://wechat.example.com"
      },
      "secretRef": "ANJING_CHANNEL_WECHAT_SECRET",
      "demoSecret": "wechat-demo-secret",
      "signatureInput": {
        "channel": "WeChat",
        "externalConversationId": "wx-open-example",
        "timestamp": "2026-06-14T03:10:00Z",
        "content": "这个商品能不能开发票？"
      },
      "request": {
        "channel": "WeChat",
        "externalConversationId": "wx-open-example",
        "externalMessageId": "wechat-msg-example-1",
        "customer": "微信客户",
        "content": "这个商品能不能开发票？",
        "timestamp": "2026-06-14T03:10:00Z",
        "signature": "f1243e26503d1e94cfa4b355eb7abd8958e34b7ae51243cb547654c3d1a9e676"
      },
      "expectedSuccess": {
        "status": 200,
        "envelope": "success"
      }
    },
    {
      "id": "wechat-adapter-inbound",
      "channel": "WeChat",
      "endpoint": "POST /api/channels/wechat/inbound",
      "headers": {
        "Content-Type": "application/json",
        "X-Channel-Origin": "https://wechat.example.com"
      },
      "secretRef": "ANJING_CHANNEL_WECHAT_SECRET",
      "demoSecret": "wechat-demo-secret",
      "signatureInput": {
        "channel": "WeChat",
        "externalConversationId": "wx-open-adapter-example",
        "timestamp": "2026-06-14T03:10:00Z",
        "content": "这个商品能不能开发票？"
      },
      "request": {
        "openId": "wx-open-adapter-example",
        "msgId": "wechat-adapter-msg-example-1",
        "nickname": "微信客户",
        "text": "这个商品能不能开发票？",
        "timestamp": "2026-06-14T03:10:00Z",
        "signature": "ce5d61a047bfcc8f7206579104c85e85750c500f01aa35b2a136cd2cfab2140d"
      },
      "expectedSuccess": {
        "status": 200,
        "envelope": "success"
      }
    },
    {
      "id": "app-adapter-inbound",
      "channel": "App",
      "endpoint": "POST /api/channels/app/inbound",
      "headers": {
        "Content-Type": "application/json",
        "X-Channel-Origin": "app://agent-customer-service"
      },
      "secretRef": "ANJING_CHANNEL_APP_SECRET",
      "demoSecret": "app-demo-secret",
      "signatureInput": {
        "channel": "App",
        "externalConversationId": "device-example-1",
        "timestamp": "2026-06-14T03:10:00Z",
        "content": "订单状态在哪里看？"
      },
      "request": {
        "deviceId": "device-example-1",
        "messageId": "app-msg-example-1",
        "userName": "App 客户",
        "body": "订单状态在哪里看？",
        "sentAt": "2026-06-14T03:10:00Z",
        "signature": "7d3aa2303fc1856febfe8f018850a59f3985fed6759dfec072333125cdd773a6"
      },
      "expectedSuccess": {
        "status": 200,
        "envelope": "success"
      }
    },
    {
      "id": "marketplace-adapter-inbound",
      "channel": "Marketplace",
      "endpoint": "POST /api/channels/marketplace/inbound",
      "headers": {
        "Content-Type": "application/json",
        "X-Channel-Origin": "https://marketplace.example.com"
      },
      "secretRef": "ANJING_CHANNEL_MARKETPLACE_SECRET",
      "demoSecret": "marketplace-demo-secret",
      "signatureInput": {
        "channel": "Marketplace",
        "externalConversationId": "buyer-example-1",
        "timestamp": "2026-06-14T03:10:00Z",
        "content": "可以修改收货地址吗？"
      },
      "request": {
        "buyerId": "buyer-example-1",
        "eventId": "market-event-example-1",
        "buyerName": "平台买家",
        "message": "可以修改收货地址吗？",
        "occurredAt": "2026-06-14T03:10:00Z",
        "signature": "25cd6c47d4c73b54e6a04bb7bdedf2c121de4ae2151ebafe69aa0f1bcc1e25d3"
      },
      "expectedSuccess": {
        "status": 200,
        "envelope": "success"
      }
    }
  ],
  "errorExamples": [
    {
      "id": "denied-origin",
      "exampleId": "wechat-standard-inbound",
      "status": 403,
      "code": "channel_origin_denied",
      "mutation": "origin",
      "reason": "Origin or X-Channel-Origin is declared but not listed in ChannelIntegration.allowedOrigins"
    },
    {
      "id": "invalid-signature",
      "exampleId": "wechat-standard-inbound",
      "status": 401,
      "code": "invalid_signature",
      "mutation": "signature",
      "reason": "Signature does not match the canonical payload and channel secret"
    },
    {
      "id": "stale-signature",
      "exampleId": "wechat-standard-inbound",
      "status": 401,
      "code": "stale_signature",
      "mutation": "timestamp",
      "reason": "Timestamp is outside ChannelIntegration.signatureWindowSeconds"
    },
    {
      "id": "rate-limited",
      "exampleId": "wechat-standard-inbound",
      "status": 429,
      "code": "channel_rate_limited",
      "mutation": "volume",
      "reason": "Channel traffic exceeds ChannelIntegration.rateLimitPerMinute in the current minute"
    },
    {
      "id": "duplicate-inbound",
      "exampleId": "wechat-standard-inbound",
      "status": 409,
      "code": "duplicate_inbound",
      "mutation": "duplicate",
      "reason": "externalMessageId or canonical signed payload was already accepted"
    }
  ]
}
