{
  "schemaVersion": 1,
  "applicationId": "agent-customer-service",
  "apiPrefix": "/api",
  "targetBasePath": "/api/customer-service",
  "boundaries": [
    {
      "id": "chat",
      "name": "Conversation Runtime",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "currentHost": "agent-customer-service",
      "basePath": "/api/chat",
      "targetBasePath": "/api/customer-service/chat",
      "apiConstantsClass": "Chat",
      "apiPathsKey": "chat",
      "controller": "backend/src/main/java/com/anjing/module/chat/ChatController.java",
      "openapi": false,
      "copyAction": "keep and gradually migrate to targetBasePath",
      "routes": [
        { "name": "runtimeOverview", "path": "/api/chat/runtime/overview", "methods": ["POST"] },
        { "name": "createSession", "path": "/api/chat/session/create", "methods": ["POST"] },
        { "name": "listSessions", "path": "/api/chat/session/list", "methods": ["POST"] },
        { "name": "getSession", "path": "/api/chat/session/get", "methods": ["POST"] },
        { "name": "deleteSession", "path": "/api/chat/session/delete", "methods": ["POST"] },
        { "name": "sendMessage", "path": "/api/chat/message/send", "methods": ["POST"] },
        { "name": "listMessages", "path": "/api/chat/message/list", "methods": ["POST"] },
        { "name": "updateContext", "path": "/api/chat/context/update", "methods": ["POST"] },
        { "name": "getContext", "path": "/api/chat/context/get", "methods": ["POST"] }
      ]
    },
    {
      "id": "knowledge",
      "name": "Knowledge Management",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "currentHost": "agent-customer-service",
      "basePath": "/api/knowledge",
      "targetBasePath": "/api/customer-service/knowledge",
      "apiConstantsClass": "Knowledge",
      "apiPathsKey": "knowledge",
      "controller": "backend/src/main/java/com/anjing/module/knowledge/KnowledgeController.java",
      "openapi": false,
      "copyAction": "keep product/activity/faq as runtime knowledge; keep industry/solution as reserved until wired into retrieval",
      "routes": [
        { "name": "overview", "path": "/api/knowledge/overview", "methods": ["POST"] },
        { "name": "productList", "path": "/api/knowledge/product/list", "methods": ["POST"] },
        { "name": "activityList", "path": "/api/knowledge/activity/list", "methods": ["POST"] },
        { "name": "faqList", "path": "/api/knowledge/faq/list", "methods": ["POST"] },
        { "name": "industryList", "path": "/api/knowledge/industry/list", "methods": ["POST"] },
        { "name": "solutionList", "path": "/api/knowledge/solution/list", "methods": ["POST"] },
        { "name": "vectorize", "path": "/api/knowledge/vectorize", "methods": ["POST"] }
      ]
    },
    {
      "id": "scene",
      "name": "Scene Configuration",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "currentHost": "agent-customer-service",
      "basePath": "/api/scene",
      "targetBasePath": "/api/customer-service/scene",
      "apiConstantsClass": "Scene",
      "apiPathsKey": "scene",
      "controller": "backend/src/main/java/com/anjing/module/scene/SceneController.java",
      "openapi": false,
      "copyAction": "keep CRUD and lightweight runtime integration; RuleEngine and PromptRuntime are already wired in lightweight mode",
      "routes": [
        { "name": "runtimeOverview", "path": "/api/scene/runtime/overview", "methods": ["POST"] },
        { "name": "intentList", "path": "/api/scene/intent/list", "methods": ["POST"] },
        { "name": "promptList", "path": "/api/scene/prompt/list", "methods": ["POST"] },
        { "name": "promptTest", "path": "/api/scene/prompt/test", "methods": ["POST"] },
        { "name": "ruleList", "path": "/api/scene/rule/list", "methods": ["POST"] },
        { "name": "ruleTest", "path": "/api/scene/rule/test", "methods": ["POST"] }
      ]
    }
  ]
}
