{
  "schemaVersion": 2,
  "applicationId": "agent-customer-service",
  "apiPrefix": "/api",
  "stack": {
    "frontend": "React + TypeScript + Vite",
    "backend": "Go + net/http",
    "database": "PostgreSQL + pgx/v5"
  },
  "boundaries": [
    {
      "id": "customer-service",
      "name": "Conversation Runtime",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "basePath": "/api/customer-service",
      "goPackage": "internal/customer",
      "routes": [
        { "name": "listConversations", "path": "/api/customer-service/conversations", "methods": ["GET"], "console": false },
        { "name": "createConversation", "path": "/api/customer-service/conversations", "methods": ["POST"], "console": false },
        { "name": "listMessages", "path": "/api/customer-service/messages", "methods": ["GET"] },
        { "name": "sendMessage", "path": "/api/customer-service/messages", "methods": ["POST"], "console": false },
        { "name": "streamMessage", "path": "/api/customer-service/messages/stream", "methods": ["POST"] }
      ]
    },
    {
      "id": "channels",
      "name": "Channel Inbound Runtime",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "basePath": "/api/channels",
      "goPackage": "internal/channels",
      "routes": [
        { "name": "receiveInboundMessage", "path": "/api/channels/inbound", "methods": ["POST"], "console": false },
        { "name": "receiveWeChatInbound", "path": "/api/channels/wechat/inbound", "methods": ["POST"], "console": false },
        { "name": "receiveWeComInbound", "path": "/api/channels/wecom/inbound", "methods": ["POST"], "console": false },
        { "name": "receiveAppInbound", "path": "/api/channels/app/inbound", "methods": ["POST"], "console": false },
        { "name": "receiveMarketplaceInbound", "path": "/api/channels/marketplace/inbound", "methods": ["POST"], "console": false },
        { "name": "receiveDouyinInbound", "path": "/api/channels/douyin/inbound", "methods": ["POST"], "console": false },
        { "name": "receiveXiaohongshuInbound", "path": "/api/channels/xiaohongshu/inbound", "methods": ["POST"], "console": false }
      ]
    },
    {
      "id": "knowledge",
      "name": "Knowledge Operations",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "basePath": "/api/knowledge",
      "goPackage": "internal/knowledge",
      "routes": [
        { "name": "listArticles", "path": "/api/knowledge/articles", "methods": ["GET"] },
        { "name": "searchKnowledge", "path": "/api/knowledge/search", "methods": ["POST"], "console": false },
        { "name": "resolveGap", "path": "/api/knowledge/gaps/resolve", "methods": ["POST"] },
        { "name": "createArticleFromGap", "path": "/api/knowledge/gaps/create-article", "methods": ["POST"] }
      ]
    },
    {
      "id": "ops",
      "name": "Operations Runtime",
      "kind": "runtime",
      "owner": "agent-customer-service",
      "basePath": "/api/ops",
      "goPackage": "internal/ops",
      "routes": [
        { "name": "dashboard", "path": "/api/ops/dashboard", "methods": ["GET"] },
        { "name": "listChannelInboundAudits", "path": "/api/ops/channel-inbound-audits", "methods": ["GET"] },
        { "name": "exportChannelInboundAudits", "path": "/api/ops/channel-inbound-audits/export", "methods": ["GET"] },
        { "name": "listChannelInboundAuditQualityEvents", "path": "/api/ops/channel-inbound-audit-quality-events", "methods": ["GET"] },
        { "name": "exportChannelInboundAuditQualityEvents", "path": "/api/ops/channel-inbound-audit-quality-events/export", "methods": ["GET"] },
        { "name": "testRule", "path": "/api/ops/rules/test", "methods": ["POST"] },
        { "name": "compareRuleVersions", "path": "/api/ops/rules/compare", "methods": ["POST"] },
        { "name": "approveRuleRelease", "path": "/api/ops/rules/approve", "methods": ["POST"] },
        { "name": "publishCanaryRule", "path": "/api/ops/rules/publish-canary", "methods": ["POST"] },
        { "name": "rollbackRule", "path": "/api/ops/rules/rollback", "methods": ["POST"] },
        { "name": "resolveTransfer", "path": "/api/ops/transfers/resolve", "methods": ["POST"] },
        { "name": "assignReviewTask", "path": "/api/ops/review-tasks/assign", "methods": ["POST"] },
        { "name": "completeReviewTask", "path": "/api/ops/review-tasks/complete", "methods": ["POST"] },
        { "name": "ackChannelNotification", "path": "/api/ops/channel-notifications/ack", "methods": ["POST"] },
        { "name": "listChannelRunbookChecks", "path": "/api/ops/channel-runbook-checks", "methods": ["GET"] },
        { "name": "exportChannelRunbookChecks", "path": "/api/ops/channel-runbook-checks/export", "methods": ["GET"] },
        { "name": "completeChannelRunbookCheck", "path": "/api/ops/channel-runbook-checks/complete", "methods": ["POST"] },
        { "name": "dispatchChannelNotification", "path": "/api/ops/channel-notifications/dispatch", "methods": ["POST"] },
        { "name": "updateChannelAlertPolicy", "path": "/api/ops/channel-alert-policies/update", "methods": ["POST"] },
        { "name": "approveNotificationPolicyChange", "path": "/api/ops/channel-alert-policies/approve-change", "methods": ["POST"] },
        { "name": "rejectNotificationPolicyChange", "path": "/api/ops/channel-alert-policies/reject-change", "methods": ["POST"] },
        { "name": "cancelNotificationPolicyChange", "path": "/api/ops/channel-alert-policies/cancel-change", "methods": ["POST"] },
        { "name": "rollbackChannelAlertPolicy", "path": "/api/ops/channel-alert-policies/rollback", "methods": ["POST"] },
        { "name": "submitAnnotation", "path": "/api/ops/annotations/submit", "methods": ["POST"] },
        { "name": "exportTrainingSamples", "path": "/api/ops/training-samples/export", "methods": ["GET"] },
        { "name": "exportChannelOpsReport", "path": "/api/ops/channel-ops-report/export", "methods": ["GET"] },
        { "name": "channelOpsReportScheduler", "path": "/api/ops/channel-ops-report-scheduler", "methods": ["GET"] },
        { "name": "compensateChannelOpsReport", "path": "/api/ops/channel-ops-report-scheduler/compensate", "methods": ["POST"] },
        { "name": "listChannelOpsReportEvents", "path": "/api/ops/channel-ops-report-events", "methods": ["GET"] },
        { "name": "exportChannelOpsReportEvents", "path": "/api/ops/channel-ops-report-events/export", "methods": ["GET"] },
        { "name": "listChannelOpsReports", "path": "/api/ops/channel-ops-reports", "methods": ["GET"] },
        { "name": "generateChannelOpsReport", "path": "/api/ops/channel-ops-reports/generate", "methods": ["POST"] },
        { "name": "exportSavedChannelOpsReport", "path": "/api/ops/channel-ops-reports/export", "methods": ["GET"] }
      ]
    }
  ]
}
