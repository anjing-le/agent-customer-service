{
  "schemaVersion": 1,
  "applicationId": "agent-customer-service",
  "apiPrefix": "/api",
  "responseEnvelope": "platform-contract.json#/responseEnvelope",
  "endpoints": [
    {
      "id": "listConversations",
      "boundary": "customer-service",
      "method": "GET",
      "path": "/api/customer-service/conversations",
      "response": { "status": 200, "schema": "Conversation[]" }
    },
    {
      "id": "createConversation",
      "boundary": "customer-service",
      "method": "POST",
      "path": "/api/customer-service/conversations",
      "request": { "body": "CreateConversationRequest" },
      "response": { "status": 201, "schema": "Conversation" }
    },
    {
      "id": "listMessages",
      "boundary": "customer-service",
      "method": "GET",
      "path": "/api/customer-service/messages",
      "request": { "query": "ListMessagesQuery" },
      "response": { "status": 200, "schema": "Message[]" }
    },
    {
      "id": "sendMessage",
      "boundary": "customer-service",
      "method": "POST",
      "path": "/api/customer-service/messages",
      "request": { "body": "SendMessageRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" }
    },
    {
      "id": "streamMessage",
      "boundary": "customer-service",
      "method": "POST",
      "path": "/api/customer-service/messages/stream",
      "request": { "body": "SendMessageRequest" },
      "response": { "status": 200, "contentType": "text/event-stream", "schema": "MessageStreamEvent" }
    },
    {
      "id": "receiveInboundMessage",
      "boundary": "channels",
      "method": "POST",
      "path": "/api/channels/inbound",
      "request": { "body": "ChannelInboundRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" },
      "errorResponses": [
        { "status": 401, "code": "invalid_signature|invalid_timestamp|stale_signature" },
        { "status": 403, "code": "channel_disabled|channel_origin_denied" },
        { "status": 409, "code": "duplicate_inbound" },
        { "status": 429, "code": "channel_rate_limited" }
      ]
    },
    {
      "id": "receiveWeChatInbound",
      "boundary": "channels",
      "method": "POST",
      "path": "/api/channels/wechat/inbound",
      "request": { "body": "WeChatInboundRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" }
    },
    {
      "id": "receiveAppInbound",
      "boundary": "channels",
      "method": "POST",
      "path": "/api/channels/app/inbound",
      "request": { "body": "AppInboundRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" }
    },
    {
      "id": "receiveMarketplaceInbound",
      "boundary": "channels",
      "method": "POST",
      "path": "/api/channels/marketplace/inbound",
      "request": { "body": "MarketplaceInboundRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" }
    },
    {
      "id": "listArticles",
      "boundary": "knowledge",
      "method": "GET",
      "path": "/api/knowledge/articles",
      "response": { "status": 200, "schema": "KnowledgeArticle[]" }
    },
    {
      "id": "searchKnowledge",
      "boundary": "knowledge",
      "method": "POST",
      "path": "/api/knowledge/search",
      "request": { "body": "SearchKnowledgeRequest" },
      "response": { "status": 200, "schema": "KnowledgeArticle[]" }
    },
    {
      "id": "resolveGap",
      "boundary": "knowledge",
      "method": "POST",
      "path": "/api/knowledge/gaps/resolve",
      "request": { "body": "ResolveByIdRequest" },
      "response": { "status": 200, "schema": "KnowledgeGap" }
    },
    {
      "id": "createArticleFromGap",
      "boundary": "knowledge",
      "method": "POST",
      "path": "/api/knowledge/gaps/create-article",
      "request": { "body": "CreateArticleFromGapRequest" },
      "response": { "status": 201, "schema": "KnowledgeArticle" }
    },
    {
      "id": "dashboard",
      "boundary": "ops",
      "method": "GET",
      "path": "/api/ops/dashboard",
      "response": { "status": 200, "schema": "Dashboard" }
    },
    {
      "id": "testRule",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/rules/test",
      "request": { "body": "TestRuleRequest" },
      "response": { "status": 200, "schema": "RuleTestResult" }
    },
    {
      "id": "compareRuleVersions",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/rules/compare",
      "request": { "body": "TestRuleRequest" },
      "response": { "status": 200, "schema": "RuleComparison" }
    },
    {
      "id": "approveRuleRelease",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/rules/approve",
      "request": { "body": "RuleApprovalRequest" },
      "response": { "status": 200, "schema": "RuleApproval" }
    },
    {
      "id": "publishCanaryRule",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/rules/publish-canary",
      "request": { "body": "RuleReleaseRequest" },
      "response": { "status": 200, "schema": "RuleReleaseEvent" }
    },
    {
      "id": "rollbackRule",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/rules/rollback",
      "request": { "body": "RuleReleaseRequest" },
      "response": { "status": 200, "schema": "RuleReleaseEvent" }
    },
    {
      "id": "resolveTransfer",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/transfers/resolve",
      "request": { "body": "ResolveTransferRequest" },
      "response": { "status": 200, "schema": "TransferTicket" }
    },
    {
      "id": "assignReviewTask",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/review-tasks/assign",
      "request": { "body": "AssignReviewTaskRequest" },
      "response": { "status": 200, "schema": "ReviewTask" }
    },
    {
      "id": "completeReviewTask",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/review-tasks/complete",
      "request": { "body": "CompleteReviewTaskRequest" },
      "response": { "status": 200, "schema": "ReviewTask" }
    },
    {
      "id": "ackChannelNotification",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/channel-notifications/ack",
      "request": { "body": "AcknowledgeChannelNotificationRequest" },
      "response": { "status": 200, "schema": "ChannelNotification" }
    },
    {
      "id": "submitAnnotation",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/annotations/submit",
      "request": { "body": "SubmitAnnotationRequest" },
      "response": { "status": 201, "schema": "Annotation" }
    },
    {
      "id": "exportTrainingSamples",
      "boundary": "ops",
      "method": "GET",
      "path": "/api/ops/training-samples/export",
      "request": { "query": "ExportTrainingSamplesQuery" },
      "response": { "status": 200, "schema": "TrainingSample[]" }
    }
  ],
  "schemas": {
    "CreateConversationRequest": {
      "fields": {
        "customer": "string",
        "channel": "string"
      }
    },
    "ListMessagesQuery": {
      "required": ["conversationId"],
      "fields": {
        "conversationId": "string"
      }
    },
    "SendMessageRequest": {
      "required": ["content"],
      "fields": {
        "conversationId": "string",
        "content": "string"
      }
    },
    "ChannelInboundRequest": {
      "required": ["channel", "externalConversationId", "content", "timestamp", "signature"],
      "fields": {
        "channel": "Web|WeChat|App|Marketplace",
        "externalConversationId": "string",
        "externalMessageId": "string",
        "customer": "string",
        "content": "string",
        "timestamp": "RFC3339 string within ANJING_CHANNEL_SIGNATURE_WINDOW_SECONDS",
        "signature": "HMAC-SHA256 hex using ChannelIntegration secretRef/env fallback; duplicate externalMessageId or signed payload returns duplicate_inbound when replayProtection is enabled; excess channel traffic returns channel_rate_limited"
      }
    },
    "WeChatInboundRequest": {
      "required": ["openId", "text", "timestamp", "signature"],
      "fields": {
        "openId": "string",
        "msgId": "string",
        "nickname": "string",
        "text": "string",
        "timestamp": "RFC3339 string",
        "signature": "HMAC-SHA256 hex over normalized WeChat inbound payload"
      }
    },
    "AppInboundRequest": {
      "required": ["deviceId", "body", "sentAt", "signature"],
      "fields": {
        "deviceId": "string",
        "messageId": "string",
        "userName": "string",
        "body": "string",
        "sentAt": "RFC3339 string",
        "signature": "HMAC-SHA256 hex over normalized App inbound payload"
      }
    },
    "MarketplaceInboundRequest": {
      "required": ["buyerId", "message", "occurredAt", "signature"],
      "fields": {
        "buyerId": "string",
        "eventId": "string",
        "buyerName": "string",
        "message": "string",
        "occurredAt": "RFC3339 string",
        "signature": "HMAC-SHA256 hex over normalized Marketplace inbound payload"
      }
    },
    "MessageStreamEvent": {
      "required": ["type"],
      "fields": {
        "type": "meta|delta|done",
        "data": "StreamMeta|StreamDelta|SendMessageResult"
      }
    },
    "StreamMeta": {
      "required": ["engine", "evidenceCount"],
      "fields": {
        "engine": "customer|rule|rag+rule|llm+rag",
        "fallbackReason": "NO_EVIDENCE|TRANSFER_THRESHOLD",
        "evidenceCount": "number",
        "trace": "AgentTrace"
      }
    },
    "StreamDelta": {
      "required": ["content"],
      "fields": {
        "content": "string"
      }
    },
    "SearchKnowledgeRequest": {
      "fields": {
        "query": "string"
      }
    },
    "ResolveByIdRequest": {
      "required": ["id"],
      "fields": {
        "id": "string"
      }
    },
    "CreateArticleFromGapRequest": {
      "required": ["gapId"],
      "fields": {
        "gapId": "string",
        "title": "string",
        "category": "string",
        "content": "string",
        "tags": "string[]"
      }
    },
    "TestRuleRequest": {
      "fields": {
        "content": "string"
      }
    },
    "RuleReleaseRequest": {
      "required": ["code"],
      "fields": {
        "code": "string",
        "actor": "string",
        "note": "string"
      }
    },
    "RuleApprovalRequest": {
      "required": ["code"],
      "fields": {
        "code": "string",
        "approver": "string",
        "riskLevel": "LOW|MEDIUM|HIGH|CRITICAL",
        "sampleCount": "number",
        "note": "string"
      }
    },
    "ResolveTransferRequest": {
      "required": ["id"],
      "fields": {
        "id": "string",
        "assignee": "string",
        "note": "string"
      }
    },
    "AssignReviewTaskRequest": {
      "required": ["id"],
      "fields": {
        "id": "string",
        "assignee": "string"
      }
    },
    "CompleteReviewTaskRequest": {
      "required": ["id"],
      "fields": {
        "id": "string"
      }
    },
    "AcknowledgeChannelNotificationRequest": {
      "required": ["id"],
      "fields": {
        "id": "string",
        "actor": "string",
        "note": "string"
      }
    },
    "SubmitAnnotationRequest": {
      "required": ["messageId"],
      "fields": {
        "messageId": "string",
        "reviewer": "string",
        "verdict": "PASS|REVIEW|FAIL",
        "note": "string",
        "dimensions": "AnnotationDimensions",
        "tags": "string[]"
      }
    },
    "ExportTrainingSamplesQuery": {
      "fields": {
        "maxScore": "number"
      }
    },
    "Conversation": {
      "required": ["id", "customer", "channel", "intent", "status", "riskLevel", "startedAt"],
      "fields": {
        "id": "string",
        "customer": "string",
        "channel": "string",
        "intent": "string",
        "status": "Active|KnowledgeGap|NeedsHuman",
        "riskLevel": "LOW|MEDIUM|HIGH",
        "startedAt": "RFC3339 string",
        "lastMessage": "string"
      }
    },
    "Message": {
      "required": ["id", "conversationId", "role", "content", "engine", "safe", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "role": "user|assistant",
        "content": "string",
        "engine": "customer|rule|rag+rule|llm+rag",
        "safe": "boolean",
        "fallbackReason": "NO_EVIDENCE|TRANSFER_THRESHOLD",
        "evidenceIds": "string[]",
        "createdAt": "RFC3339 string",
        "trace": "AgentTrace"
      }
    },
    "AgentTrace": {
      "required": ["strategy", "evidenceCount", "historyCount", "modelAttempted", "modelFallback"],
      "fields": {
        "strategy": "human_transfer|no_evidence_fallback|evidence_answer",
        "evidenceCount": "number",
        "historyCount": "number",
        "modelAttempted": "boolean",
        "model": "string",
        "modelDurationMs": "number",
        "modelFallback": "boolean",
        "modelFallbackReason": "string"
      }
    },
    "KnowledgeArticle": {
      "required": ["id", "title", "category", "content", "tags", "trustLevel", "updatedAt"],
      "fields": {
        "id": "string",
        "title": "string",
        "category": "string",
        "content": "string",
        "tags": "string[]",
        "trustLevel": "LOW|MEDIUM|HIGH",
        "updatedAt": "RFC3339 string"
      }
    },
    "KnowledgeGap": {
      "required": ["id", "conversationId", "question", "reason", "status", "priority", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "question": "string",
        "reason": "NO_EVIDENCE",
        "status": "OPEN|RESOLVED",
        "priority": "LOW|MEDIUM|HIGH",
        "createdAt": "RFC3339 string"
      }
    },
    "Rule": {
      "required": ["id", "code", "name", "trigger", "action", "enabled", "version", "stage", "hitCount"],
      "fields": {
        "id": "string",
        "code": "NO_EVIDENCE_FALLBACK|TRANSFER_THRESHOLD|CANCEL_RISK_TRANSFER",
        "name": "string",
        "trigger": "string",
        "action": "string",
        "enabled": "boolean",
        "version": "string",
        "stage": "active|canary|archived",
        "hitCount": "number",
        "lastHitAt": "RFC3339 string"
      }
    },
    "RuleTestResult": {
      "required": ["input", "matched", "action", "riskLevel", "fallback", "reason", "recommended"],
      "fields": {
        "input": "string",
        "matched": "boolean",
        "ruleCode": "string",
        "action": "string",
        "riskLevel": "LOW|MEDIUM|HIGH",
        "fallback": "boolean",
        "reason": "string",
        "recommended": "string"
      }
    },
    "RuleComparison": {
      "required": ["input", "current", "canary", "changed", "recommendation"],
      "fields": {
        "input": "string",
        "current": "RuleTestResult",
        "canary": "RuleTestResult",
        "changed": "boolean",
        "recommendation": "string"
      }
    },
    "RuleReleaseEvent": {
      "required": ["id", "ruleCode", "version", "action", "actor", "note", "createdAt"],
      "fields": {
        "id": "string",
        "ruleCode": "string",
        "version": "string",
        "action": "PUBLISH|ROLLBACK",
        "actor": "string",
        "note": "string",
        "createdAt": "RFC3339 string"
      }
    },
    "RuleApproval": {
      "required": ["id", "ruleCode", "approver", "riskLevel", "sampleCount", "status", "note", "createdAt"],
      "fields": {
        "id": "string",
        "ruleCode": "string",
        "approver": "string",
        "riskLevel": "LOW|MEDIUM|HIGH|CRITICAL",
        "sampleCount": "number",
        "status": "APPROVED|REJECTED",
        "note": "string",
        "createdAt": "RFC3339 string"
      }
    },
    "TransferTicket": {
      "required": ["id", "conversationId", "channel", "question", "reason", "priority", "status", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "channel": "string",
        "question": "string",
        "reason": "TRANSFER_THRESHOLD",
        "priority": "LOW|MEDIUM|HIGH|CRITICAL",
        "status": "OPEN|RESOLVED",
        "slaMinutes": "number",
        "waitMinutes": "number",
        "slaStatus": "ON_TRACK|BREACHED|RESOLVED",
        "escalated": "boolean",
        "assignee": "string",
        "resolutionNote": "string",
        "createdAt": "RFC3339 string",
        "resolvedAt": "RFC3339 string",
        "events": "TransferEvent[]"
      }
    },
    "TransferEvent": {
      "required": ["type", "actor", "note", "createdAt"],
      "fields": {
        "type": "CREATED|RESOLVED",
        "actor": "string",
        "note": "string",
        "createdAt": "RFC3339 string"
      }
    },
    "Annotation": {
      "required": ["id", "messageId", "reviewer", "verdict", "note", "dimensions", "tags", "score", "createdAt"],
      "fields": {
        "id": "string",
        "messageId": "string",
        "reviewer": "string",
        "verdict": "PASS|REVIEW|FAIL",
        "note": "string",
        "dimensions": "AnnotationDimensions",
        "tags": "string[]",
        "score": "number",
        "createdAt": "RFC3339 string"
      }
    },
    "AnnotationDimensions": {
      "required": ["groundedness", "safety", "helpfulness"],
      "fields": {
        "groundedness": "number",
        "safety": "number",
        "helpfulness": "number"
      }
    },
    "ReviewTask": {
      "required": ["id", "messageId", "conversationId", "channel", "status", "priority", "reason", "createdAt"],
      "fields": {
        "id": "string",
        "messageId": "string",
        "conversationId": "string",
        "channel": "string",
        "assignee": "string",
        "status": "OPEN|ASSIGNED|COMPLETED",
        "priority": "NORMAL|HIGH",
        "reason": "string",
        "createdAt": "RFC3339 string",
        "completedAt": "RFC3339 string"
      }
    },
    "TrainingSample": {
      "required": ["id", "conversationId", "messageId", "channel", "prompt", "answer", "engine", "evidenceIds", "reviewer", "verdict", "score", "dimensions", "note", "tags", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "messageId": "string",
        "channel": "string",
        "prompt": "string",
        "answer": "string",
        "engine": "customer|rule|rag+rule|llm+rag",
        "evidenceIds": "string[]",
        "reviewer": "string",
        "verdict": "PASS|REVIEW|FAIL",
        "score": "number",
        "dimensions": "AnnotationDimensions",
        "note": "string",
        "tags": "string[]",
        "createdAt": "RFC3339 string"
      }
    },
    "Metric": {
      "required": ["label", "value", "note"],
      "fields": {
        "label": "string",
        "value": "string",
        "note": "string"
      }
    },
    "Dashboard": {
      "required": ["metrics", "conversations", "knowledgeGaps", "rules", "transfers", "channelPolicies", "integrations", "channelAlerts", "channelFailureTrends", "channelAlertPolicies", "channelNotifications", "quality", "annotations", "reviewTasks", "ruleApprovals", "ruleEvents"],
      "fields": {
        "metrics": "Metric[]",
        "conversations": "Conversation[]",
        "knowledgeGaps": "KnowledgeGap[]",
        "rules": "Rule[]",
        "transfers": "TransferTicket[]",
        "channelPolicies": "ChannelPolicy[]",
        "integrations": "ChannelIntegration[]",
        "channelAlerts": "ChannelAlert[]",
        "channelFailureTrends": "ChannelFailureTrend[]",
        "channelAlertPolicies": "ChannelAlertPolicy[]",
        "channelNotifications": "ChannelNotification[]",
        "quality": "QualitySummary",
        "annotations": "Annotation[]",
        "reviewTasks": "ReviewTask[]",
        "ruleApprovals": "RuleApproval[]",
        "ruleEvents": "RuleReleaseEvent[]"
      }
    },
    "ChannelAlert": {
      "required": ["channel", "code", "count", "lastReason", "lastOrigin", "lastSeenAt"],
      "fields": {
        "channel": "string",
        "code": "string",
        "count": "number",
        "lastReason": "string",
        "lastOrigin": "string",
        "lastSeenAt": "RFC3339 string"
      }
    },
    "ChannelFailureTrend": {
      "required": ["channel", "bucketStart", "count"],
      "fields": {
        "channel": "string",
        "bucketStart": "RFC3339 string",
        "count": "number"
      }
    },
    "ChannelAlertPolicy": {
      "required": ["channel", "severity", "threshold", "windowMinutes", "notifyTarget", "enabled", "active", "currentCount"],
      "fields": {
        "channel": "string",
        "severity": "LOW|MEDIUM|HIGH|CRITICAL",
        "threshold": "number",
        "windowMinutes": "number",
        "notifyTarget": "string",
        "enabled": "boolean",
        "active": "boolean",
        "currentCount": "number",
        "lastTriggeredAt": "RFC3339 string"
      }
    },
    "ChannelNotification": {
      "required": ["id", "channel", "severity", "target", "status", "reason", "count", "createdAt"],
      "fields": {
        "id": "string",
        "channel": "string",
        "severity": "LOW|MEDIUM|HIGH|CRITICAL",
        "target": "string",
        "status": "OPEN|ACKED",
        "reason": "string",
        "count": "number",
        "createdAt": "RFC3339 string",
        "ackedBy": "string",
        "ackNote": "string",
        "ackedAt": "RFC3339 string"
      }
    },
    "ChannelPolicy": {
      "required": ["channel", "displayName", "tone", "slaMinutes", "riskBoost", "escalationNote", "enabled"],
      "fields": {
        "channel": "string",
        "displayName": "string",
        "tone": "string",
        "slaMinutes": "number",
        "riskBoost": "NORMAL|HIGH",
        "escalationNote": "string",
        "enabled": "boolean"
      }
    },
    "ChannelIntegration": {
      "required": ["channel", "displayName", "enabled", "secretSource", "secretRef", "nextSecretRef", "signatureWindowSeconds", "replayProtection", "allowedOrigins", "rateLimitPerMinute", "rotationHint", "updatedAt"],
      "fields": {
        "channel": "string",
        "displayName": "string",
        "enabled": "boolean",
        "secretSource": "env|database",
        "secretRef": "string",
        "nextSecretRef": "string",
        "signatureWindowSeconds": "number",
        "replayProtection": "boolean",
        "allowedOrigins": "string[]",
        "rateLimitPerMinute": "number",
        "rotationHint": "string",
        "rotatesAt": "RFC3339 string",
        "updatedAt": "RFC3339 string"
      }
    },
    "QualitySummary": {
      "required": ["score", "reviewedMessages", "evidenceAnswers", "safeFallbacks", "humanTransfers", "annotationCount", "averageReview", "notes"],
      "fields": {
        "score": "number",
        "reviewedMessages": "number",
        "evidenceAnswers": "number",
        "safeFallbacks": "number",
        "humanTransfers": "number",
        "annotationCount": "number",
        "averageReview": "number",
        "notes": "string[]"
      }
    },
    "SendMessageResult": {
      "required": ["conversation", "userMessage", "agentMessage", "evidence"],
      "fields": {
        "conversation": "Conversation",
        "userMessage": "Message",
        "agentMessage": "Message",
        "evidence": "KnowledgeArticle[]",
        "gap": "KnowledgeGap"
      }
    }
  }
}
