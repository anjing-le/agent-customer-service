{
  "schemaVersion": 1,
  "applicationId": "agent-customer-service",
  "apiPrefix": "/api",
  "responseEnvelope": "platform-contract.json#/responseEnvelope",
  "endpoints": [
    {
      "id": "listConversations",
      "boundary": "customer-service",
      "method": "GET",
      "path": "/api/customer-service/conversations",
      "response": { "status": 200, "schema": "Conversation[]" }
    },
    {
      "id": "createConversation",
      "boundary": "customer-service",
      "method": "POST",
      "path": "/api/customer-service/conversations",
      "request": { "body": "CreateConversationRequest" },
      "response": { "status": 201, "schema": "Conversation" }
    },
    {
      "id": "listMessages",
      "boundary": "customer-service",
      "method": "GET",
      "path": "/api/customer-service/messages",
      "request": { "query": "ListMessagesQuery" },
      "response": { "status": 200, "schema": "Message[]" }
    },
    {
      "id": "sendMessage",
      "boundary": "customer-service",
      "method": "POST",
      "path": "/api/customer-service/messages",
      "request": { "body": "SendMessageRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" }
    },
    {
      "id": "streamMessage",
      "boundary": "customer-service",
      "method": "POST",
      "path": "/api/customer-service/messages/stream",
      "request": { "body": "SendMessageRequest" },
      "response": { "status": 200, "contentType": "text/event-stream", "schema": "MessageStreamEvent" }
    },
    {
      "id": "receiveInboundMessage",
      "boundary": "channels",
      "method": "POST",
      "path": "/api/channels/inbound",
      "request": { "body": "ChannelInboundRequest" },
      "response": { "status": 200, "schema": "SendMessageResult" },
      "errorResponses": [
        { "status": 401, "code": "invalid_signature|invalid_timestamp|stale_signature" },
        { "status": 409, "code": "duplicate_inbound" }
      ]
    },
    {
      "id": "listArticles",
      "boundary": "knowledge",
      "method": "GET",
      "path": "/api/knowledge/articles",
      "response": { "status": 200, "schema": "KnowledgeArticle[]" }
    },
    {
      "id": "searchKnowledge",
      "boundary": "knowledge",
      "method": "POST",
      "path": "/api/knowledge/search",
      "request": { "body": "SearchKnowledgeRequest" },
      "response": { "status": 200, "schema": "KnowledgeArticle[]" }
    },
    {
      "id": "resolveGap",
      "boundary": "knowledge",
      "method": "POST",
      "path": "/api/knowledge/gaps/resolve",
      "request": { "body": "ResolveByIdRequest" },
      "response": { "status": 200, "schema": "KnowledgeGap" }
    },
    {
      "id": "createArticleFromGap",
      "boundary": "knowledge",
      "method": "POST",
      "path": "/api/knowledge/gaps/create-article",
      "request": { "body": "CreateArticleFromGapRequest" },
      "response": { "status": 201, "schema": "KnowledgeArticle" }
    },
    {
      "id": "dashboard",
      "boundary": "ops",
      "method": "GET",
      "path": "/api/ops/dashboard",
      "response": { "status": 200, "schema": "Dashboard" }
    },
    {
      "id": "testRule",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/rules/test",
      "request": { "body": "TestRuleRequest" },
      "response": { "status": 200, "schema": "RuleTestResult" }
    },
    {
      "id": "resolveTransfer",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/transfers/resolve",
      "request": { "body": "ResolveTransferRequest" },
      "response": { "status": 200, "schema": "TransferTicket" }
    },
    {
      "id": "submitAnnotation",
      "boundary": "ops",
      "method": "POST",
      "path": "/api/ops/annotations/submit",
      "request": { "body": "SubmitAnnotationRequest" },
      "response": { "status": 201, "schema": "Annotation" }
    },
    {
      "id": "exportTrainingSamples",
      "boundary": "ops",
      "method": "GET",
      "path": "/api/ops/training-samples/export",
      "request": { "query": "ExportTrainingSamplesQuery" },
      "response": { "status": 200, "schema": "TrainingSample[]" }
    }
  ],
  "schemas": {
    "CreateConversationRequest": {
      "fields": {
        "customer": "string",
        "channel": "string"
      }
    },
    "ListMessagesQuery": {
      "required": ["conversationId"],
      "fields": {
        "conversationId": "string"
      }
    },
    "SendMessageRequest": {
      "required": ["content"],
      "fields": {
        "conversationId": "string",
        "content": "string"
      }
    },
    "ChannelInboundRequest": {
      "required": ["channel", "externalConversationId", "content", "timestamp", "signature"],
      "fields": {
        "channel": "Web|WeChat|App|Marketplace",
        "externalConversationId": "string",
        "customer": "string",
        "content": "string",
        "timestamp": "RFC3339 string within ANJING_CHANNEL_SIGNATURE_WINDOW_SECONDS",
        "signature": "HMAC-SHA256 hex using channel env secret; duplicate signed payload returns duplicate_inbound"
      }
    },
    "MessageStreamEvent": {
      "required": ["type"],
      "fields": {
        "type": "meta|delta|done",
        "data": "StreamMeta|StreamDelta|SendMessageResult"
      }
    },
    "StreamMeta": {
      "required": ["engine", "evidenceCount"],
      "fields": {
        "engine": "customer|rule|rag+rule|llm+rag",
        "fallbackReason": "NO_EVIDENCE|TRANSFER_THRESHOLD",
        "evidenceCount": "number",
        "trace": "AgentTrace"
      }
    },
    "StreamDelta": {
      "required": ["content"],
      "fields": {
        "content": "string"
      }
    },
    "SearchKnowledgeRequest": {
      "fields": {
        "query": "string"
      }
    },
    "ResolveByIdRequest": {
      "required": ["id"],
      "fields": {
        "id": "string"
      }
    },
    "CreateArticleFromGapRequest": {
      "required": ["gapId"],
      "fields": {
        "gapId": "string",
        "title": "string",
        "category": "string",
        "content": "string",
        "tags": "string[]"
      }
    },
    "TestRuleRequest": {
      "fields": {
        "content": "string"
      }
    },
    "ResolveTransferRequest": {
      "required": ["id"],
      "fields": {
        "id": "string",
        "assignee": "string",
        "note": "string"
      }
    },
    "SubmitAnnotationRequest": {
      "required": ["messageId"],
      "fields": {
        "messageId": "string",
        "reviewer": "string",
        "verdict": "PASS|REVIEW|FAIL",
        "note": "string",
        "dimensions": "AnnotationDimensions",
        "tags": "string[]"
      }
    },
    "ExportTrainingSamplesQuery": {
      "fields": {
        "maxScore": "number"
      }
    },
    "Conversation": {
      "required": ["id", "customer", "channel", "intent", "status", "riskLevel", "startedAt"],
      "fields": {
        "id": "string",
        "customer": "string",
        "channel": "string",
        "intent": "string",
        "status": "Active|KnowledgeGap|NeedsHuman",
        "riskLevel": "LOW|MEDIUM|HIGH",
        "startedAt": "RFC3339 string",
        "lastMessage": "string"
      }
    },
    "Message": {
      "required": ["id", "conversationId", "role", "content", "engine", "safe", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "role": "user|assistant",
        "content": "string",
        "engine": "customer|rule|rag+rule|llm+rag",
        "safe": "boolean",
        "fallbackReason": "NO_EVIDENCE|TRANSFER_THRESHOLD",
        "evidenceIds": "string[]",
        "createdAt": "RFC3339 string",
        "trace": "AgentTrace"
      }
    },
    "AgentTrace": {
      "required": ["strategy", "evidenceCount", "historyCount", "modelAttempted", "modelFallback"],
      "fields": {
        "strategy": "human_transfer|no_evidence_fallback|evidence_answer",
        "evidenceCount": "number",
        "historyCount": "number",
        "modelAttempted": "boolean",
        "model": "string",
        "modelDurationMs": "number",
        "modelFallback": "boolean",
        "modelFallbackReason": "string"
      }
    },
    "KnowledgeArticle": {
      "required": ["id", "title", "category", "content", "tags", "trustLevel", "updatedAt"],
      "fields": {
        "id": "string",
        "title": "string",
        "category": "string",
        "content": "string",
        "tags": "string[]",
        "trustLevel": "LOW|MEDIUM|HIGH",
        "updatedAt": "RFC3339 string"
      }
    },
    "KnowledgeGap": {
      "required": ["id", "conversationId", "question", "reason", "status", "priority", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "question": "string",
        "reason": "NO_EVIDENCE",
        "status": "OPEN|RESOLVED",
        "priority": "LOW|MEDIUM|HIGH",
        "createdAt": "RFC3339 string"
      }
    },
    "Rule": {
      "required": ["id", "code", "name", "trigger", "action", "enabled"],
      "fields": {
        "id": "string",
        "code": "NO_EVIDENCE_FALLBACK|TRANSFER_THRESHOLD",
        "name": "string",
        "trigger": "string",
        "action": "string",
        "enabled": "boolean"
      }
    },
    "RuleTestResult": {
      "required": ["input", "matched", "action", "riskLevel", "fallback", "reason", "recommended"],
      "fields": {
        "input": "string",
        "matched": "boolean",
        "ruleCode": "string",
        "action": "string",
        "riskLevel": "LOW|MEDIUM|HIGH",
        "fallback": "boolean",
        "reason": "string",
        "recommended": "string"
      }
    },
    "TransferTicket": {
      "required": ["id", "conversationId", "channel", "question", "reason", "priority", "status", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "channel": "string",
        "question": "string",
        "reason": "TRANSFER_THRESHOLD",
        "priority": "LOW|MEDIUM|HIGH|CRITICAL",
        "status": "OPEN|RESOLVED",
        "slaMinutes": "number",
        "waitMinutes": "number",
        "slaStatus": "ON_TRACK|BREACHED|RESOLVED",
        "escalated": "boolean",
        "assignee": "string",
        "resolutionNote": "string",
        "createdAt": "RFC3339 string",
        "resolvedAt": "RFC3339 string",
        "events": "TransferEvent[]"
      }
    },
    "TransferEvent": {
      "required": ["type", "actor", "note", "createdAt"],
      "fields": {
        "type": "CREATED|RESOLVED",
        "actor": "string",
        "note": "string",
        "createdAt": "RFC3339 string"
      }
    },
    "Annotation": {
      "required": ["id", "messageId", "reviewer", "verdict", "note", "dimensions", "tags", "score", "createdAt"],
      "fields": {
        "id": "string",
        "messageId": "string",
        "reviewer": "string",
        "verdict": "PASS|REVIEW|FAIL",
        "note": "string",
        "dimensions": "AnnotationDimensions",
        "tags": "string[]",
        "score": "number",
        "createdAt": "RFC3339 string"
      }
    },
    "AnnotationDimensions": {
      "required": ["groundedness", "safety", "helpfulness"],
      "fields": {
        "groundedness": "number",
        "safety": "number",
        "helpfulness": "number"
      }
    },
    "TrainingSample": {
      "required": ["id", "conversationId", "messageId", "channel", "prompt", "answer", "engine", "evidenceIds", "reviewer", "verdict", "score", "dimensions", "note", "tags", "createdAt"],
      "fields": {
        "id": "string",
        "conversationId": "string",
        "messageId": "string",
        "channel": "string",
        "prompt": "string",
        "answer": "string",
        "engine": "customer|rule|rag+rule|llm+rag",
        "evidenceIds": "string[]",
        "reviewer": "string",
        "verdict": "PASS|REVIEW|FAIL",
        "score": "number",
        "dimensions": "AnnotationDimensions",
        "note": "string",
        "tags": "string[]",
        "createdAt": "RFC3339 string"
      }
    },
    "Metric": {
      "required": ["label", "value", "note"],
      "fields": {
        "label": "string",
        "value": "string",
        "note": "string"
      }
    },
    "Dashboard": {
      "required": ["metrics", "conversations", "knowledgeGaps", "rules", "transfers", "channelPolicies", "integrations", "quality", "annotations"],
      "fields": {
        "metrics": "Metric[]",
        "conversations": "Conversation[]",
        "knowledgeGaps": "KnowledgeGap[]",
        "rules": "Rule[]",
        "transfers": "TransferTicket[]",
        "channelPolicies": "ChannelPolicy[]",
        "integrations": "ChannelIntegration[]",
        "quality": "QualitySummary",
        "annotations": "Annotation[]"
      }
    },
    "ChannelPolicy": {
      "required": ["channel", "displayName", "tone", "slaMinutes", "riskBoost", "escalationNote", "enabled"],
      "fields": {
        "channel": "string",
        "displayName": "string",
        "tone": "string",
        "slaMinutes": "number",
        "riskBoost": "NORMAL|HIGH",
        "escalationNote": "string",
        "enabled": "boolean"
      }
    },
    "ChannelIntegration": {
      "required": ["channel", "displayName", "enabled", "secretSource", "secretRef", "signatureWindowSeconds", "replayProtection", "rotationHint", "updatedAt"],
      "fields": {
        "channel": "string",
        "displayName": "string",
        "enabled": "boolean",
        "secretSource": "env|database",
        "secretRef": "string",
        "signatureWindowSeconds": "number",
        "replayProtection": "boolean",
        "rotationHint": "string",
        "updatedAt": "RFC3339 string"
      }
    },
    "QualitySummary": {
      "required": ["score", "reviewedMessages", "evidenceAnswers", "safeFallbacks", "humanTransfers", "annotationCount", "averageReview", "notes"],
      "fields": {
        "score": "number",
        "reviewedMessages": "number",
        "evidenceAnswers": "number",
        "safeFallbacks": "number",
        "humanTransfers": "number",
        "annotationCount": "number",
        "averageReview": "number",
        "notes": "string[]"
      }
    },
    "SendMessageResult": {
      "required": ["conversation", "userMessage", "agentMessage", "evidence"],
      "fields": {
        "conversation": "Conversation",
        "userMessage": "Message",
        "agentMessage": "Message",
        "evidence": "KnowledgeArticle[]",
        "gap": "KnowledgeGap"
      }
    }
  }
}
